# ============================================================================
# 911 AI Flow Demo - Environment Configuration
# ============================================================================
# IMPORTANT: Copy this file to .env and update with your actual values
# DO NOT commit .env to version control
# ============================================================================

# ----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ----------------------------------------------------------------------------
POSTGRES_DB=emergency_demo
POSTGRES_USER=emergency_user
POSTGRES_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION

# Database connection string (used by services)
DATABASE_URL=postgresql://emergency_user:CHANGE_THIS_PASSWORD_IN_PRODUCTION@postgres:5432/emergency_demo

# ----------------------------------------------------------------------------
# n8n Orchestrator Configuration
# ----------------------------------------------------------------------------
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=CHANGE_THIS_PASSWORD_IN_PRODUCTION

# n8n network configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678

# n8n encryption key (generate with: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=CHANGE_THIS_TO_RANDOM_32_CHAR_HEX

# ----------------------------------------------------------------------------
# API Services Configuration
# ----------------------------------------------------------------------------

# api-ingest (Port 8001)
API_INGEST_PORT=8001
API_INGEST_HOST=0.0.0.0
API_INGEST_LOG_LEVEL=INFO

# api-triage (Port 8002)
API_TRIAGE_PORT=8002
API_TRIAGE_HOST=0.0.0.0
API_TRIAGE_LOG_LEVEL=INFO

# api-analytics (Port 8003)
API_ANALYTICS_PORT=8003
API_ANALYTICS_HOST=0.0.0.0
API_ANALYTICS_LOG_LEVEL=INFO

# api-gateway (Port 8010) - CORS proxy for Lovable
API_GATEWAY_PORT=8010
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_LOG_LEVEL=INFO
API_GATEWAY_TIMEOUT=15.0

# ----------------------------------------------------------------------------
# Lovable Dashboard Configuration (Frontend)
# ----------------------------------------------------------------------------

# Gateway URLs para Lovable (via api-gateway :8010)
# Directo a n8n (sin gateway): http://localhost:5678/webhook/911-call
VITE_N8N_WEBHOOK_URL=http://localhost:8010/911-call
VITE_ANALYTICS_SUMMARY_URL=http://localhost:8010/analytics/summary
VITE_ANALYTICS_PREDICTIONS_URL=http://localhost:8010/analytics/predictions

# Demo mode settings
VITE_DEMO_MODE=true
VITE_SHOW_PRIVACY_WARNINGS=true
# Gate SOLID: consentimiento OFF por defecto (privacidad by design)
VITE_SOLID_CONSENT_DEFAULT=false

# ----------------------------------------------------------------------------
# Security Configuration
# ----------------------------------------------------------------------------

# Webhook authentication token (for external calls to n8n)
# Generate with: openssl rand -hex 32
WEBHOOK_AUTH_TOKEN=CHANGE_THIS_TO_RANDOM_TOKEN

# API internal communication (optional, for service-to-service auth)
INTERNAL_API_KEY=CHANGE_THIS_TO_RANDOM_KEY

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5678

# ----------------------------------------------------------------------------
# Demo Configuration
# ----------------------------------------------------------------------------

# Enable demo mode (adds test data, relaxed validation)
DEMO_MODE=true

# Enable debug logging
DEBUG=false

# Maximum requests per minute (rate limiting)
RATE_LIMIT_PER_MINUTE=60

# ----------------------------------------------------------------------------
# Application Settings
# ----------------------------------------------------------------------------

# Application environment
ENVIRONMENT=development

# Timezone
TZ=America/Mexico_City

# Language
LANG=es_MX.UTF-8

# ----------------------------------------------------------------------------
# Docker Compose Settings
# ----------------------------------------------------------------------------

# Compose project name
COMPOSE_PROJECT_NAME=centinela-cdmx-ia

# Docker network name
DOCKER_NETWORK=centinela-network

# ----------------------------------------------------------------------------
# Data Retention (for demo purposes)
# ----------------------------------------------------------------------------

# Days to keep raw conversations
RAW_DATA_RETENTION_DAYS=30

# Days to keep analytics data
ANALYTICS_RETENTION_DAYS=90

# Days to keep metrics cache
METRICS_CACHE_RETENTION_DAYS=7

# ----------------------------------------------------------------------------
# Performance Tuning
# ----------------------------------------------------------------------------

# Database connection pool size
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# API worker processes (per service)
API_WORKERS=2

# Request timeout (seconds)
REQUEST_TIMEOUT=30

# ----------------------------------------------------------------------------
# Monitoring & Logging
# ----------------------------------------------------------------------------

# Log format (json or text)
LOG_FORMAT=json

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Enable request logging
LOG_REQUESTS=true

# Enable SQL query logging
LOG_SQL_QUERIES=false

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------

# Enable PII redaction
ENABLE_PII_REDACTION=true

# Enable P0 signal detection
ENABLE_P0_DETECTION=true

# Enable NNA (Niñas, Niños, Adolescentes) protection
ENABLE_NNA_PROTECTION=true

# Enable mock predictions
ENABLE_MOCK_PREDICTIONS=true

# ----------------------------------------------------------------------------
# External Services (for future integration)
# ----------------------------------------------------------------------------

# SMS notification service (optional)
SMS_API_KEY=
SMS_API_URL=

# Email notification service (optional)
EMAIL_API_KEY=
EMAIL_API_URL=

# Geolocation service (optional)
GEO_API_KEY=
GEO_API_URL=

# ----------------------------------------------------------------------------
# Notes
# ----------------------------------------------------------------------------
# 1. Generate secure passwords: openssl rand -base64 32
# 2. Generate hex keys: openssl rand -hex 32
# 3. Never commit .env file to git
# 4. Update all CHANGE_THIS_* values before deployment
# 5. Use strong passwords in production (min 16 characters)
# 6. Rotate credentials regularly
# 7. Keep this file secure and backed up
# ============================================================================